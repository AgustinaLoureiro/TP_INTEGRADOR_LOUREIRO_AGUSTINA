<%- include("partials/head.ejs") %>
<%- include("partials/navbar.ejs") %>

<div class="container my-4">
    <h3 class="mb-4">Registros</h3>

    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <small class="text-muted">Total facturado</small>
                <h4>$<%= estadisticas.totalFacturado %></h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <small class="text-muted">Cantidad de ventas</small>
                <h4><%= estadisticas.cantidadVentas %></h4>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 text-center">
                <small class="text-muted">Puntaje promedio encuestas</small>
                <h4><%= estadisticas.promedioEncuestas %></h4>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <a href="/admin/ventas/excel" class="btn btn-success">⬇️ Excel de ventas</a>
        <a href="/admin/encuestas/excel" class="btn btn-outline-success">⬇️ Excel de encuestas</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card p-3">
                <h5>Top 10 productos más vendidos</h5>
                <table class="table table-sm">
                    <thead><tr><th>Producto</th><th class="text-end">Unidades vendidas</th></tr></thead>
                    <tbody>
                        <% topProductos.forEach(item => { %>
                            <tr>
                                <td><%= item.Producto ? item.Producto.nombre : "Producto eliminado" %></td>
                                <td class="text-end"><%= item.get("totalVendido") %></td>
                            </tr>
                        <% }) %>
                        <% if (topProductos.length === 0) { %>
                            <tr><td colspan="2" class="text-muted text-center">Sin ventas todavía</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card p-3">
                <h5>Top 10 ventas más caras</h5>
                <table class="table table-sm">
                    <thead><tr><th>Cliente</th><th>Fecha</th><th class="text-end">Total</th></tr></thead>
                    <tbody>
                        <% topVentas.forEach(venta => { %>
                            <tr>
                                <td><%= venta.nombre_cliente %></td>
                                <td><%= new Date(venta.fecha).toLocaleDateString("es-AR") %></td>
                                <td class="text-end">$<%= Number(venta.precio_total).toFixed(2) %></td>
                            </tr>
                        <% }) %>
                        <% if (topVentas.length === 0) { %>
                            <tr><td colspan="3" class="text-muted text-center">Sin ventas todavía</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-12">
            <div class="card p-3">
                <h5>Log de inicios de sesión (admin)</h5>
                <table class="table table-sm">
                    <thead><tr><th>Usuario</th><th>Email</th><th>Fecha</th></tr></thead>
                    <tbody>
                        <% logs.forEach(log => { %>
                            <tr>
                                <td><%= log.Usuario ? log.Usuario.nombre : "-" %></td>
                                <td><%= log.Usuario ? log.Usuario.email : "-" %></td>
                                <td><%= new Date(log.fecha).toLocaleString("es-AR") %></td>
                            </tr>
                        <% }) %>
                        <% if (logs.length === 0) { %>
                            <tr><td colspan="3" class="text-muted text-center">Sin registros</td></tr>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<%- include("partials/footer.ejs") %>